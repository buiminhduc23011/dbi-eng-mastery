[Unit]
Description=EngMastery English SRS Lab
After=network.target

[Service]
Type=simple
User=ducne
WorkingDirectory=/home/ducne/engmastery/server
ExecStart=/home/ducne/engmastery/server/EngMastery.Api
Restart=always
RestartSec=5
Environment=ASPNETCORE_URLS=http://*:8090
Environment="ConnectionStrings__Sqlite=Data Source=/home/ducne/engmastery/data/engmastery.db"
# --- SQL Server alternative ---
# Environment=Database__Provider=sqlserver
# Environment=ConnectionStrings__SqlServer=Server=192.168.11.101,1433;Database=EngMastery;User Id=sa;Password=ChangeMe_12345;TrustServerCertificate=True

[Install]
WantedBy=multi-user.target
